{
  "name": "valve-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace tooling for valve",
  "homepage": "https://valvejs.vercel.app/",
  "bugs": {
    "url": "https://github.com/ksaurav24/valve/issues"
  },
  "license": "Apache-2.0",
  "author": "Saurav K. <ksaurav4093@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksaurav24/valve.git"
  },
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "11.28.4"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --project tsconfig.tooling.json && pnpm --filter valvejs build && pnpm --recursive --if-present typecheck",
    "build": "pnpm --recursive --if-present build",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && prettier --write packages/valve/package.json packages/valve/CHANGELOG.md",
    "prepare": "husky",
    "test": "pnpm --filter valvejs test",
    "test:coverage": "pnpm --filter valvejs test:coverage",
    "test:integration": "pnpm --filter valvejs test:integration",
    "test:types": "pnpm --filter valvejs test:types",
    "docs:dev": "pnpm --filter @valve/web dev",
    "docs:build": "pnpm --filter @valve/web build",
    "check:source": "node scripts/check-source.mjs",
    "check:package": "pnpm --filter valvejs check:package",
    "check:size": "pnpm --filter valvejs check:size",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:types && pnpm build && pnpm check:source && pnpm check:package && pnpm check:size",
    "bench": "pnpm --filter valvejs exec tsx bench/local.ts",
    "examples": "pnpm --recursive --workspace-concurrency=1 --filter \"@valve/example-*\" start",
    "bench:compare": "pnpm --filter valvejs exec tsx bench/compare.ts",
    "bench:paced": "pnpm --filter valvejs exec tsx bench/paced.ts",
    "bench:drift": "node packages/valve/bench/drift.mjs",
    "codegraph:sync": "codegraph sync"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "luamin": "1.0.4",
    "prettier": "3.9.9",
    "semver": "7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
