{
  "name": "valve-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace tooling for valve",
  "license": "Apache-2.0",
  "author": "Saurav K. <ksaurav4093@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksaurav24/valve.git"
  },
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "11.28.4"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --project tsconfig.tooling.json && pnpm --recursive --if-present typecheck",
    "build": "pnpm --recursive --if-present build",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && pnpm format",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.71.1"
  }
}
