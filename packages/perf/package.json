{
  "name": "@valve/perf",
  "private": true,
  "version": "0.0.0",
  "description": "Valve performance, load, and correctness harness. Not published.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
