    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "ioredis": "5.11.1",
    "p-limit": "7.3.3",
    "p-queue": "9.3.3",
    "tinybench": "6.2.2",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "valvejs": "workspace:*",
    "vitest": "5.0.3"
  }
}
