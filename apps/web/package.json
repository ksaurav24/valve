{
  "name": "@valve/web",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-content.mjs && node scripts/sync-metadata.mjs",
    "sync:snapshot": "node scripts/sync-metadata.mjs --write-snapshot",
    "social:images": "node scripts/generate-social-images.mjs",
    "dev": "pnpm sync && next dev --hostname 127.0.0.1 --port 4321",
    "build": "pnpm sync && pnpm --filter valvejs docs:api && next build --webpack",
    "preview": "python3 -m http.server 4321 --bind 127.0.0.1 --directory out",
    "typecheck": "pnpm sync && fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "node scripts/sync-content.mjs && fumadocs-mdx",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@radix-ui/react-accordion": "1.3.1",
    "clsx": "2.1.1",
    "framer-motion": "14.10.1",
    "fumadocs-core": "16.18.3",
    "fumadocs-mdx": "15.5.2",
    "fumadocs-ui": "16.18.3",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@next/env": "16.4.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "zod": "4.6.7"
  }
}
